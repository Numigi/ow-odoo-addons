version: '3'
services:
  db:
    image: postgres:13
    environment:
      - POSTGRES_PASSWORD=odoo
      - POSTGRES_USER=odoo
      - POSTGRES_DB=postgres
    restart: unless-stopped
    volumes:
      - odoo-db-data:/var/lib/postgresql/data
    ports:
      - "5432:5432"

  odoo:
    image: odoo:14
    platform: linux/amd64
    depends_on:
      - db
    ports:
      - "8069:8069"
    environment:
      - HOST=db
      - USER=odoo
      - PASSWORD=odoo
    volumes:
      - .:/mnt/extra-addons
      - odoo-data:/var/lib/odoo
    restart: unless-stopped
    command: --dev=all --log-level=debug

volumes:
  odoo-db-data:
  odoo-data:
